# Sistema de feedback (F1) — en /api/ solo son accesibles los dos endpoints.
# Todo lo demás (incluido _feedback-common.php, que solo se usa vía require)
# se deniega, y no hay listado de directorio.

Options -Indexes

<IfModule mod_authz_core.c>
  Require all denied
  <FilesMatch "^(feedback|feedback-export)\.php$">
    Require all granted
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  Order deny,allow
  Deny from all
  <FilesMatch "^(feedback|feedback-export)\.php$">
    Allow from all
  </FilesMatch>
</IfModule>

# Apache con PHP-FPM/CGI no entrega la cabecera Authorization a PHP por
# defecto; feedback-export.php la necesita para el token Bearer.
<IfModule mod_setenvif.c>
  SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
